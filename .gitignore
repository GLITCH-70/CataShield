# ==============================================================================
# CataShield - Cataract Segmentation Adversarial Robustness Project
# Git Ignore Configuration for GitHub
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Python Bytecode, Caches & Runtime Artifacts
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# ------------------------------------------------------------------------------
# 2. Virtual Environments & Package Managers
# ------------------------------------------------------------------------------
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/
.conda/
pip-log.txt
pip-delete-this-directory.txt

# ------------------------------------------------------------------------------
# 3. Datasets, Annotations & Mask Artifacts
# (Cataract-1K raw videos/frames, Supervisely JSONs, and rasterized masks)
# ------------------------------------------------------------------------------
dataset/
dataset_download/
masks/
masks_colored/
data/
raw_data/
processed_data/
Annotations/

# ------------------------------------------------------------------------------
# 4. Large Data Blobs, NumPy Caches & Archives
# (Local array caches and raw serialized evaluation dumps)
# ------------------------------------------------------------------------------
cache/
*.npy
*.npz
*.h5
*.hdf5
*.pkl
*.pickle
*.parquet
*.feather

# Compressed archives
*.zip
*.tar
*.tar.gz
*.tar.bz2
*.7z
*.rar

# ------------------------------------------------------------------------------
# 5. Machine Learning Models, Checkpoints & Training Logs
# (Prevent pushing large .pth / .pt / tensorboard files to GitHub)
# ------------------------------------------------------------------------------
runs/
checkpoints/
weights/
saved_models/
*.pth
*.pt
*.ckpt
*.bin
*.onnx
*.safetensors
*.tflite
wandb/
.tensorboard/
events.out.tfevents.*
logs/
*.log

# ------------------------------------------------------------------------------
# 6. Experimental Runs & Generated Evaluation Results
# (All generated benchmark outputs, raw metrics, and replication check dumps)
# ------------------------------------------------------------------------------
results/
results_908frames/
results_debug/

# ------------------------------------------------------------------------------
# 7. Compiled Documents, Office Binaries & Generated Figures
# ------------------------------------------------------------------------------
*.pdf
*.docx
*.doc
*.pptx
*.ppt
*.xlsx
*.xls

# Generated paper figures
paper/figures/*.pdf
paper/figures/*.png
paper/overleaf_upload.zip

# ------------------------------------------------------------------------------
# 8. LaTeX Auxiliary & Compilation Build Files
# ------------------------------------------------------------------------------
*.aux
*.bbl
*.blg
*.fls
*.fdb_latexmk
*.synctex.gz
*.out
*.toc
*.nav
*.snm
*.vrb

# ------------------------------------------------------------------------------
# 9. Executables, Tool Binaries & Libraries
# ------------------------------------------------------------------------------
tools/
*.exe
*.dll
*.dylib

# ------------------------------------------------------------------------------
# 10. IDEs, Editors & OS System Files
# ------------------------------------------------------------------------------
# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# JetBrains / PyCharm
.idea/

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Linux & Editor Swap
*~
*.swp
*.swo

# ------------------------------------------------------------------------------
# 11. Environment Secrets & API Credentials
# ------------------------------------------------------------------------------
.env
.env.local
.env.*.local
*.secret
*.pem
*.key
.synapseConfig

# ------------------------------------------------------------------------------
# 12. Temporary & Scratch Files
# ------------------------------------------------------------------------------
scratch/
tmp/
temp/
*.tmp
*.bak
